# Copy to .env and fill in. Everything here stays on the server; nothing is sent to the browser.

# Required: key from https://build.nvidia.com (avatar -> API Keys). Starts with nvapi-
NVIDIA_API_KEY=nvapi-your-key-here

# Optional overrides (defaults shown). Any chat model from https://integrate.api.nvidia.com/v1/models works.
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_CHECK_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# NIM_WRITE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NIM_TRANSLATE_MODEL=nvidia/nemotron-3-ultra-550b-a55b   (nvidia/riva-translate-4b-instruct-v2 is faster but less fluent)
# NIM_MAX_CONCURRENCY=4

# Optional: enables web search for the plagiarism checker and Citation Finder (https://brave.com/search/api/).
# Without it, plagiarism checks compare against your own documents and any sources you paste in.
# BRAVE_API_KEY=

# Server port (the app opens at http://localhost:4317)
# PORT=4317
